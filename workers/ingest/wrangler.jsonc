{
  "name": "mstudio-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "info",
    "QUOTA_MODE": "SAFE",
    "S3_ENDPOINT": "https://s3.minds.io.vn",
    "S3_MEDIA_BUCKET": "mstudio-media",
    "S3_RAW_BUCKET": "mstudio-raw"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mstudio_dev",
      "database_id": "6cef0de8-cd16-4494-a809-d1d177be002e"
    }
  ],
  "triggers": {
    "crons": []
  },
  "queues": {
    "producers": [
      {
        "binding": "NORMALIZE_QUEUE",
        "queue": "mstudio-normalize"
      }
    ]
  },
  "env": {
    "dev": {
      "name": "mstudio-ingest-dev",
      "vars": {
        "ENVIRONMENT": "dev",
        "LOG_LEVEL": "debug"
      }
    },
    "staging": {
      "name": "mstudio-ingest-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "LOG_LEVEL": "info"
      }
    }
  }
}
