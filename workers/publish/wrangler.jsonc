{
  "name": "mstudio-publish",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "vars": {
    "ENVIRONMENT": "dev",
    "LOG_LEVEL": "debug",
    "SITE_URL": "https://news.example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mstudio_dev",
      "database_id": "local-dev-placeholder"
    }
  ]
}
