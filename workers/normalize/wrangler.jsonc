{
  "name": "mstudio-normalize",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "vars": {
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "info"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mstudio_dev",
      "database_id": "6cef0de8-cd16-4494-a809-d1d177be002e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "mstudio-raw"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "mstudio-normalize",
        "max_batch_size": 5,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
