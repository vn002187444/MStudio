{
  "name": "mstudio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "vars": {
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "info",
    "QUOTA_MODE": "SAFE",
    "READER_EVENT_SAMPLING_RATE": "0.05",
    "S3_ENDPOINT": "https://s3.minds.io.vn",
    "S3_MEDIA_BUCKET": "mstudio-media",
    "S3_RAW_BUCKET": "mstudio-raw"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mstudio_dev",
      "database_id": "6cef0de8-cd16-4494-a809-d1d177be002e"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "mstudio-events"
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "vn002187444@gmail.com"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
